### Confirmaciones

```typescript
// Usar MatDialog o servicio custom para confirmaciones
confirm(message: string): Observable<boolean> {
  return this.dialog.open(ConfirmDialogComponent, {
    data: { message }
  }).afterClosed();
}

// Uso
deleteUser(user: User): void {
  this.dialogService.confirm('¿Estás seguro de eliminar este usuario?')
    .pipe(
      filter(confirmed => confirmed),
      switchMap(() => this.userService.delete(user.id))
    )
    .subscribe(() => {
      this.notificationService.success('Usuario eliminado');
      this.loadUsers();
    });
}
```

